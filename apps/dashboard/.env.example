# ClickHouse HTTP interface (port 8123). May embed credentials and database.
CLICKHOUSE_URL=http://default:@localhost:8123/costobs

# Postgres DSN for metadata (orgs, api_keys, alert_rules).
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/costobs?sslmode=disable

# Auth: "none" (default, single-user dev) or "oidc" (self-hosted SSO, optional).
COSTOBS_AUTH_MODE=none

# Org used in "none" mode (and as OIDC fallback).
COSTOBS_DEFAULT_ORG_SLUG=default
