# CostObs — single config surface for local dev (Mode A). Copy to .env.
# Everything here stays on your machine. No value is ever phoned home.

# --- ClickHouse ---
CLICKHOUSE_DB=costobs
CLICKHOUSE_USER=costobs
CLICKHOUSE_PASSWORD=costobs

# --- Postgres ---
POSTGRES_DB=costobs
POSTGRES_USER=costobs
POSTGRES_PASSWORD=costobs

# --- Dev seed (so an SDK example works in <5 min) ---
COSTOBS_DEV_ORG_SLUG=default
COSTOBS_DEV_API_KEY=costobs_dev_secret_key

# --- Dashboard auth: none (single-user dev) | oidc (self-hosted) ---
COSTOBS_AUTH_MODE=none

# --- OIDC (only when COSTOBS_AUTH_MODE=oidc) ---
# COSTOBS_OIDC_ISSUER=
# COSTOBS_OIDC_CLIENT_ID=
# COSTOBS_OIDC_CLIENT_SECRET=
