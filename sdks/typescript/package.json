{
  "name": "@costobs/sdk",
  "version": "0.1.0",
  "description": "CostObs TypeScript/Node SDK — drop-in AI/LLM cost observability.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/data"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
